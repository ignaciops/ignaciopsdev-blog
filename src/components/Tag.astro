---
interface Props {
  tag: string;
  size?: 'sm' | 'md';
  variant?: 'default' | 'interactive';
}

const { tag, size = 'sm', variant = 'interactive' } = Astro.props;

const sizeClasses = {
  sm: 'px-2 py-0.5 text-[0.65rem]',
  md: 'px-2.5 py-1 text-xs'
};

const variantClasses = variant === 'interactive'
  ? 'hover:bg-ink hover:text-surface transition-colors'
  : '';
---

<a
  data-testid={`tag-${tag}`}
  href={`/tags/${tag}`}
  class={`inline-block border border-line text-ink-2 font-mono uppercase tracking-[0.08em] leading-none ${sizeClasses[size]} ${variantClasses}`}
>
  #{tag}
</a>
