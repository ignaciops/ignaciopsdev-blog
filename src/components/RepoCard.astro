---
interface Props {
  title: string;
  description: string;
  tags: string[];
  repoUrl: string;
}

const { title, description, tags, repoUrl } = Astro.props;
---

<a
  data-testid="repo-card"
  href={repoUrl}
  class="group relative block border-2 border-line bg-surface p-5 transition-all duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:hard-shadow-sm"
>
  <div class="flex justify-between items-start gap-3">
    <div class="flex items-center gap-2.5 min-w-0">
      <!-- Icono de repo -->
      <svg class="w-4 h-4 shrink-0 text-ink-3 transition-colors group-hover:text-signal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
      </svg>
      <h3 data-testid="repo-card-title" class="font-sans font-bold text-lg tracking-tight truncate transition-colors group-hover:text-signal-text">
        {title}
      </h3>
    </div>
    <!-- Arrow icon -->
    <svg class="w-4 h-4 shrink-0 text-ink-3 transition-all group-hover:text-signal-text group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </div>

  <p data-testid="repo-card-description" class="mt-3 text-sm leading-relaxed text-ink-2">
    {description}
  </p>

  <div data-testid="repo-card-tags" class="mt-4 flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <span class="inline-flex items-center border border-line-soft px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-ink-2">
        {tag}
      </span>
    ))}
  </div>
</a>
