---
import { siteConfig } from '../config/site';

interface Button {
  text: string;
  link: string;
  variant: 'primary' | 'secondary';
}

interface Props {
  title?: string;
  description?: string;
  buttons?: Button[];
  eyebrow?: string;
}

// Nota: el prop `backgroundImage` del hero anterior fue retirado a propósito.
// El contenido (YAML/Keystatic) puede seguir enviándolo; la capa visual decide
// no usar hero images a pantalla completa: la identidad es tipográfica.
const { title, description, buttons, eyebrow = 'Blog técnico · QA · Arquitectura de software' } = Astro.props;
---

<section data-testid="hero-section" class="relative w-full overflow-hidden border-b-2 border-line">
  <!-- Retícula editorial sutil: estructura, no decoración -->
  <div class="masthead-grid absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 sm:px-8 py-14 sm:py-20 lg:py-24">
    <!-- Línea de identidad -->
    <p class="mono-label flex items-center gap-3">
      <span class="signal-square" aria-hidden="true"></span>
      {eyebrow}
    </p>

    {title && (
      <h1
        data-testid="hero-title"
        class="mt-6 font-sans font-bold uppercase tracking-tight leading-[0.95] text-[clamp(2.5rem,8vw,4.75rem)] max-w-[18ch]"
      >
        {title}
      </h1>
    )}

    {!title && (
      <h1
        data-testid="hero-title"
        class="mt-6 font-sans font-bold uppercase tracking-tight leading-[0.95] text-[clamp(2.5rem,8vw,4.75rem)]"
      >
        {siteConfig.name}
      </h1>
    )}

    {description && (
      <p data-testid="hero-description" class="mt-6 text-lg sm:text-xl text-ink-2 leading-relaxed max-w-[52ch]">
        {description}
      </p>
    )}

    {buttons && buttons.length > 0 && (
      <div data-testid="hero-buttons" class="mt-10 flex flex-wrap gap-3">
        {buttons.map(button => (
          <a
            data-testid={`hero-button-${button.variant}`}
            href={button.link}
            class:list={[
              'brutal-btn',
              { 'brutal-btn--ghost': button.variant === 'secondary' }
            ]}
          >
            {button.text}
          </a>
        ))}
      </div>
    )}
  </div>
</section>
