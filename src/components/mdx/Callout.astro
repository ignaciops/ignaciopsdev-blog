---
export interface Props {
  type?: 'note' | 'tip' | 'warning' | 'danger' | 'info';
  title?: string;
  content?: string;
}

const { type = 'note', title, content } = Astro.props;

// Semántica antes que apariencia: el tipo define el mensaje; el renderer
// (global.css) traduce ese significado a color y forma.
const config = {
  note: {
    mark: '■',
    defaultTitle: 'Nota'
  },
  tip: {
    mark: '✚',
    defaultTitle: 'Consejo'
  },
  warning: {
    mark: '▲',
    defaultTitle: 'Advertencia'
  },
  danger: {
    mark: '✕',
    defaultTitle: 'Peligro'
  },
  info: {
    mark: '◆',
    defaultTitle: 'Información'
  }
};

const currentConfig = config[type];
---

<aside class={`callout callout--${type}`} role="note">
  <p class="callout__label">
    <span class="callout__mark" aria-hidden="true">{currentConfig.mark}</span>
    {title || currentConfig.defaultTitle}
  </p>
  <div class="callout__body">
    {content ? <p set:html={content.replace(/\n/g, '<br>')} /> : <slot />}
  </div>
</aside>
