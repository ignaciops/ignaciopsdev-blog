---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<div data-testid="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
  {images.map((image, index) => (
    <div data-testid={`gallery-item-${index}`} class="border-2 border-line overflow-hidden">
      <Image src={image.src} alt={image.alt} class="w-full h-auto" />
      {image.caption && (
        <p class="border-t-2 border-line bg-surface-2 px-3 py-2 font-mono text-xs text-ink-2 leading-relaxed">{image.caption}</p>
      )}
    </div>
  ))}
</div>
