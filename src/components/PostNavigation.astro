---
interface Post {
  slug: string;
  data: {
    title: string;
    date: Date;
  };
}

interface Props {
  prev?: Post | null;
  next?: Post | null;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav data-testid="post-navigation" class="mt-16 not-prose">
    <p class="mono-label flex items-center gap-3 mb-4">
      <span class="signal-square" aria-hidden="true"></span>
      Navegación
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {prev && (
        <a data-testid="previous-post-link" href={`/blog/${prev.slug}`} class="group block border-2 border-line p-5 transition-colors hover:bg-ink">
          <div class="mono-label transition-colors group-hover:text-surface/70">
            ← Anterior
          </div>
          <div class="mt-2 font-sans font-bold text-lg leading-snug tracking-tight transition-colors group-hover:text-surface">
            {prev.data.title}
          </div>
        </a>
      )}

      {next && (
        <a data-testid="next-post-link" href={`/blog/${next.slug}`} class={`group block border-2 border-line p-5 transition-colors hover:bg-ink ${!prev ? 'md:col-start-2' : ''}`}>
          <div class="mono-label text-right transition-colors group-hover:text-surface/70">
            Siguiente →
          </div>
          <div class="mt-2 font-sans font-bold text-lg leading-snug tracking-tight text-right transition-colors group-hover:text-surface">
            {next.data.title}
          </div>
        </a>
      )}
    </div>
  </nav>
)}
