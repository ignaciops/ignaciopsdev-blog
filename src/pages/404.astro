---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const pageTitle = `Página no encontrada | ${siteConfig.name}`;
---

<BaseLayout title={pageTitle}>
  <div class="flex flex-col items-start justify-center min-h-[60vh]">
    <p class="mono-label flex items-center gap-3">
      <span class="signal-square" aria-hidden="true"></span>
      Error 404 / Recurso no encontrado
    </p>

    <h1 class="mt-6 font-mono font-bold text-[clamp(5rem,20vw,11rem)] leading-none tracking-tighter">
      404
    </h1>

    <div class="mt-6 border-t-2 border-line pt-6 max-w-[52ch]">
      <h2 class="font-sans font-bold text-2xl tracking-tight">
        Página no encontrada
      </h2>
      <p class="mt-3 text-ink-2 leading-relaxed">
        Lo siento, la página que buscas no existe o ha sido movida.
      </p>
    </div>

    <div class="mt-8 flex gap-3 flex-wrap">
      <a href="/" class="brutal-btn">
        Volver al inicio
      </a>

      <a href="/blog" class="brutal-btn brutal-btn--ghost">
        Ver el blog
      </a>
    </div>
  </div>
</BaseLayout>
