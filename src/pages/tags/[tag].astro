---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const allTags = new Set<string>();
  posts.forEach(post => {
    if (post.data.tags) {
        post.data.tags.forEach(tag => allTags.add(tag));
    }
  });

  return Array.from(allTags).map(tag => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;
const posts = (await getCollection('posts', ({ data }) =>
    data.tags ? data.tags.includes(tag!) : false
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`Posts tagged with "${tag}"`}>
    <PageHeader
      label="Tag"
      title={`#${tag}`}
      count={posts.length}
      countLabel="publicaciones"
      testId="tag-page-title"
      description={`Publicaciones etiquetadas con «${tag}».`}
    />

    <div data-testid="tag-posts-list" class="border-b border-line-soft">
        {posts.map(post => (
            <PostCard
                title={post.data.title}
                slug={post.slug}
                date={post.data.date}
                summary={post.data.summary || ''}
                tags={post.data.tags}
                readingText={post.body}
            />
        ))}
    </div>
</BaseLayout>
