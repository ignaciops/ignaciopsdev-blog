---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import RepoCard from '../../components/RepoCard.astro';

const projects = await getCollection('portfolio');
---

<BaseLayout title="Ignacio PS - Portafolio">
    <PageHeader
      label="Portafolio"
      title="Proyectos"
      count={projects.length}
      countLabel="proyectos"
      description="Una selección de proyectos en los que he trabajado, y los avances de la ruta de aprendizaje de arquitectura de pruebas durante 2026. Actualizaciones mensuales con nuevos proyectos."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
            <RepoCard
                title={project.data.name}
                description={project.data.description}
                tags={project.data.stack}
                repoUrl={`/portfolio/${project.slug}`}
            />
        ))}
    </div>
</BaseLayout>
