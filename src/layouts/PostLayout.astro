---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import TagList from '../components/TagList.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PostNavigation from '../components/PostNavigation.astro';
import { siteConfig } from '../config/site';

interface Props {
  frontmatter: any;
  headings: any[];
  body: string;
  prev?: any;
  next?: any;
}

const { frontmatter, headings, body, prev, next } = Astro.props;

const pageTitle = `${frontmatter.title} | ${siteConfig.name}`;
const description = frontmatter.metaDescription || frontmatter.summary || siteConfig.description;
const ogImage = frontmatter.ogImage || frontmatter.coverImage || siteConfig.defaultOgImage;
---

<BaseLayout
  title={pageTitle}
  description={description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={frontmatter.date}
  tags={frontmatter.tags}
  wideContainer={true}
>
    <!-- POST HEADER (Volver, Título, Metadata, Resumen, Tags) -->
    <header data-testid="post-header" class="not-prose">
      <a href="/blog" class="mono-label inline-flex items-center gap-2 transition-colors hover:text-signal-text">
        <span aria-hidden="true">←</span> Blog / Publicaciones
      </a>

      <h1 data-testid="post-title" class="mt-6 font-sans font-bold text-3xl sm:text-4xl lg:text-5xl leading-[1.05] tracking-tight max-w-[26ch]">
        {frontmatter.title}
      </h1>

      <!-- Metadata -->
      <div class="mt-6 mb-7 border-y border-line-soft py-3">
        <PostMeta date={frontmatter.date} readingText={body} dateFormat="long" />
      </div>

      <!-- Resumen / entrada editorial -->
      {(frontmatter.summary || frontmatter.metaDescription) && (
        <p class="text-lg sm:text-xl text-ink-2 leading-relaxed max-w-[58ch]">
          {frontmatter.summary || frontmatter.metaDescription}
        </p>
      )}

      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="mt-6">
          <TagList tags={frontmatter.tags} size="md" />
        </div>
      )}
    </header>

    <!-- COVER IMAGE (si existe): evidencia enmarcada, nunca hero a pantalla completa -->
    {frontmatter.coverImage && (
      <figure class="mt-10 not-prose border-2 border-line">
        <Image
          data-testid="post-cover-image"
          src={frontmatter.coverImage}
          alt={frontmatter.title}
          width={1200}
          height={675}
          class="w-full h-auto object-cover"
          loading="eager"
          decoding="async"
        />
        {frontmatter.coverImageAttribution && (
          <figcaption class="border-t-2 border-line bg-surface-2 px-4 py-2.5 font-mono text-xs text-ink-2" set:html={frontmatter.coverImageAttribution} />
        )}
      </figure>
    )}

    <!-- CONTENIDO + ÍNDICE -->
    <div class="relative mt-12 lg:grid lg:grid-cols-12 lg:gap-0 items-start">
        <!-- ARTICLE CONTENT -->
        <article
          data-testid="post-content"
          class="prose lg:col-span-8 lg:border-r-2 lg:border-line lg:pr-10 xl:pr-14"
        >
            <slot />
        </article>

        <!-- SIDEBAR (TOC) -->
        <div class="hidden lg:block lg:col-span-4 lg:pl-8 xl:pl-10 sticky top-24 self-start">
          <TableOfContents headings={headings} />
        </div>
    </div>

    <!-- POST NAVIGATION -->
    <PostNavigation prev={prev} next={next} />

    <script>
      // Envoltorio editorial de los bloques de código: barra con etiqueta de
      // lenguaje + botón copiar. El contenido sigue siendo un simple <pre>.
      function initCodeBlocks() {
        const pres = document.querySelectorAll<HTMLElement>('pre.astro-code, pre[data-language]');

        pres.forEach((pre) => {
          if (pre.parentElement?.classList.contains('code-wrap')) return;

          const language = pre.getAttribute('data-language') || 'código';

          const wrap = document.createElement('div');
          wrap.className = 'code-wrap';

          const bar = document.createElement('div');
          bar.className = 'code-wrap__bar';

          const label = document.createElement('span');
          label.textContent = language;

          const copyBtn = document.createElement('button');
          copyBtn.type = 'button';
          copyBtn.className = 'code-copy';
          copyBtn.textContent = 'copiar';
          copyBtn.setAttribute('aria-label', `Copiar código ${language}`);
          copyBtn.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
            try {
              await navigator.clipboard.writeText(code);
              copyBtn.textContent = 'copiado ✓';
              copyBtn.dataset.copied = 'true';
              setTimeout(() => {
                copyBtn.textContent = 'copiar';
                delete copyBtn.dataset.copied;
              }, 2000);
            } catch {
              copyBtn.textContent = 'error';
            }
          });

          bar.appendChild(label);
          bar.appendChild(copyBtn);

          pre.parentNode?.insertBefore(wrap, pre);
          wrap.appendChild(bar);
          wrap.appendChild(pre);
        });
      }

      document.addEventListener('astro:page-load', initCodeBlocks);
    </script>
</BaseLayout>
